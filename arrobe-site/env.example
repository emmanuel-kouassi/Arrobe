# ===================================================================
# Variables d'environnement — Association @Rrobe
# -------------------------------------------------------------------
# Copie ce fichier en `.env` et remplis les valeurs.
# `.env` est ignoré par git : il ne doit JAMAIS être commité.
# ===================================================================

# --- Base de données PostgreSQL ------------------------------------
# DATABASE_URL : utilisée par l'application via l'adaptateur pg.
#                Chez Neon, prends la chaîne « pooled » (avec -pooler).
# DIRECT_URL   : utilisée par les migrations (prisma migrate, studio).
#                Chez Neon, la chaîne sans -pooler.
# Si ton hébergeur ne propose qu'une seule URL, laisse DIRECT_URL vide :
# prisma.config.js retombera automatiquement sur DATABASE_URL.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/arrobe?schema=public"
DIRECT_URL="postgresql://utilisateur:motdepasse@hote:5432/arrobe?schema=public"

# --- Compte administrateur unique ----------------------------------
# Lus uniquement par le script de seed (npm run db:seed).
# Le mot de passe est hashé avec bcrypt avant insertion : la base ne
# contient jamais sa version en clair.
#
# ADMIN_USERNAME : identifiant de connexion choisi à la main.
#                  Ce n'est pas une adresse e-mail.
# ADMIN_PASSWORD : 12 caractères minimum (le seed refuse en dessous).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# --- Signature des jetons de session -------------------------------
# Secret utilisé pour signer les jetons JWT de l'administration.
# 32 caractères minimum. Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Le changer déconnecte immédiatement toutes les sessions en cours.
JWT_SECRET=""

# --- Newsletter (Brevo) --------------------------------------------
# Sans ces trois variables, la publication fonctionne normalement mais
# aucun e-mail n'est envoyé (un avertissement est écrit dans les logs).
#
# BREVO_API_KEY       Brevo > SMTP & API > onglet « Clés API ».
#                     Ne pas confondre avec la clé SMTP.
# BREVO_SENDER_EMAIL  L'adresse expéditrice vérifiée dans Brevo
#                     (Expéditeurs, domaines & IP dédiées > Expéditeurs).
# SITE_URL            Adresse publique du site, sans / final. Sert aux
#                     liens des e-mails (article, désinscription).
#                     Sur Vercel, si elle est absente, le domaine de
#                     production est utilisé automatiquement.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
SITE_URL="https://ton-site.vercel.app"
